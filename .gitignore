# Workspace development artifacts
workspaces/*/run_loop.log
workspaces/*/eval_review.html
workspaces/*/launch_all.py
skill-test-workspace/

# 논문 PDF 렌더링/크롭 이미지 -- 저작권 있는 논문 페이지 복제본, 저장소에 안 넣음
workspaces/*/paper_pages/
workspaces/*/fig*_zoom*.png
# 2026-10-07 옛 엔진 산출물 디렉터리를 legacy/workspaces/ 로 옮김 -- 같은 규칙
skills/analog-gmid-design/legacy/workspaces/*/paper_pages/
skills/analog-gmid-design/legacy/workspaces/*/fig*_zoom*.png

# bkit runtime/snapshots (auto-generated, local) — .bkit/state/ is tracked
.bkit/runtime/
.bkit/snapshots/

# Logs
*.log
*.log.bak
stdout.log*

# Python bytecode (eval/gate 실행 부산물)
__pycache__/
*.pyc

# 조사 스크립트가 남기는 측정 결과(재현 가능한 생성물 -- 핵심 수치는 각 스크립트
# docstring에 기록한다). 2026-09-08: 프로브가 결과를 파일로도 쓰게 바뀌었다.
skills/analog-gmid-design/legacy/tests/*.result.txt
skills/analog-gmid-design/legacy/tests/*.sizing_cache.json
skills/analog-gmid-design/legacy/tests/*.theta_star.json
skills/analog-gmid-design/legacy/tests/*.unwired_theta.json
skills/analog-gmid-design/legacy/tests/*.window_dump.txt
skills/analog-gmid-design/assets/library/.bkit/

# 역할 분리 부트스트랩 ①·④(계획 N3.12.6): 탐색 아카이브와 실행 산출물은 추적하지 않는다(EL2 무시 목록)
skills/analog-gmid-design/assets/library/*.search_archive/
# S0 수준 graph 스냅샷 디스크 직렬화(설계 40 §2.4.3, 계획 N3.5 -- 실행 사이 재사용 캐시, 재생성 가능)
skills/analog-gmid-design/gmid_engine/.s0_snapshot/
runs/

# topology 원문 보관(assets/*/sources/<폴더>/)의 쪽 렌더·내장 이미지 -- source.pdf 에서 다시 만들 수 있는 생성물이라 git 에 넣지 않는다
# (사용자 2026-10-14). 없으면 skill 폴더에서 `python tools/pdf_to_md.py ensure`.
skills/analog-gmid-design/assets/*/sources/*/pages/
skills/analog-gmid-design/assets/*/sources/*/images/
