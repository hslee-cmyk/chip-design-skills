+    root, reg, inv = _p10b_make_root(tmp_path / "ok", _p10b_registry(_p10b_section8()), _p10b_inventory())
+    rc, recs = _p10b_run(root, reg, capsys, inv)
+    assert recs == []
+    assert rc == 0
