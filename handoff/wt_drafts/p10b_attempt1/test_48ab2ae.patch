+# df23-section
+# ---------------------------------------------------------------------------------------------------------------
+def test_p10b_section_missing_title_only_finding():
+    # oracle (a): §8 없는 레지스트리 -- 계약 3 "제목 줄이 없으면 이 발견 하나만 내고 다른 규칙은 보지 않는다".
+    findings = check_df23(_p10b_registry(None), _p10b_inventory(), _P10B_INV_REL)
