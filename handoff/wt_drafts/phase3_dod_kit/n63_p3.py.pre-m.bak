"""Phase 3 DoD N6.3 공통 조건 1~5(Phase 2 DoD n63 절차를 phase 3 목록으로). 읽기 전용(git show/log/merge-base/diff-tree).

    python -B n63_p3.py <iso> <H> <P2D> <out.json> [phase]

1 판정 기록 전수 V1~V10 ∈ {PASS, N/A}
2 `^phase: 3$` spec card 전부 판정 기록 있음, 목록 = p3_cards.PHASE3(20장)
3 EL4 형식: 기록을 마지막으로 바꾼 커밋 = Role: audit + Change-Id, H 조상; test-only 아니면 'merge <id>' 병합 커밋 정확히 1개(H 조상),
  test-only면 병합 0·code null·audit 커밋 단일 부모 = test_commit; base/test/code H 조상
4 카드 밖 엔진 변경 0: P2D..H(nomerge: clean merge 제외, evil merge 포함) 중 엔진 경로(Phase 2와 같은 세 pathspec) + tools/migrate/* 를 바꾼 커밋 전부 Role code/test + phase 3 목록 Change-Id.
  r1: 커밋 0개면 PENDING(공허 -- Phase 2는 기대 개수 31로 막았다). 덮음 대조: 목록 card 판정 기록의 test_commit·code_commit(null 아닌 것) 중
  엔진 경로를 바꾼 커밋은 모두 4번 목록에 있어야 한다(없으면 FAIL). 엔진 경로를 바꾸지 않은 커밋(예: 레지스트리 문서만)은 목록에 들 수 없으므로
  '경로 밖'으로 적기만 한다.
5 동작 변경 card 증거: red-green = red.test_ids·failure_hashes 비어 있지 않음 + V2 PASS; test-only = 4번 목록에서 그 card 커밋의 Role 집합이
  정확히 {test}(r1: 빈 집합은 FAIL); equivalence = V2 PASS + basis 비어 있지 않음(r1: 비면 '근거 문장 없음' FAIL -- outputs_hash만으로 통과 금지,
  '병합본 문장 인용'인지는 auditor가 인용으로 판정한다)
(관찰, 판정 아님) Phase 3 기간 0.5 card V 판정과 3번 같은 행 검사(r1, review §5-6), P2D..H tools/gates 커밋의 trailer
nomerge(2026-10-06 사용자 승인): 4번·관찰 tools/gates의 git log에서 --no-merges를 뺐다. 기본 history simplification은 그 경로가 한 부모와
  같은 merge를 거르고, 남은 merge(두 부모 모두와 다름)는 merge_class()로 가른다: 자동 병합(git merge-tree --write-tree, 두 부모)을 다시 만들어
  그 경로 내용이 merge 커밋과 같으면 'clean'(보통 --no-ff gate merge -- 목록에서 빼고 merges_clean에 적기만), 다르면 'evil'(merge에서만 바꾼
  내용 -- 충돌 해결 포함, 부모 3개 이상도) = Role/Change-Id 대조 대상(trailer 없으면 bad). merge-tree가 쓰는 tree 객체는 임시 객체 디렉터리에만
  쓴다(GIT_OBJECT_DIRECTORY + alternates -- 복제본 .git은 그대로).
"""
import collections
import json
import os
import re
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import p3_cards  # noqa: E402

ENGINE = ["skills/analog-gmid-design/assets/*.py", "workspaces/run_harness.py",
          "skills/analog-gmid-design/assets/library/*.json", "tools/migrate/*"]


P2_IDS = ["20260923-probe-dead-delete", "20260923-probe-relocate", "20260923-probe-promote-clean",
          "20260923-probe-promote-differential", "20260929-probe-engine-dup", "20260923-d-delete-dead",
          "20260923-d-delete-telescopic", "20260930-d-move-tests", "20260930-registry-grade-fix",
          "20260930-dup-w-calc", "20260930-p9-kcl-edges", "20260930-p10-df23-inventory",
          "20260930-df23-registry-record", "20260930-restore-plan-functions", "20260930-df35-harness-paths",
          "20260930-df36-instance-relpath", "20261001-topology-md-sync"]


def verdict_str(ok, pending=False):
    return "PENDING" if pending else ("PASS" if ok else "FAIL")


def main(iso, H, P2D, out, phase="3"):
    with tempfile.TemporaryDirectory(prefix="n63_objs_") as objdir:
        _main(iso, H, P2D, out, phase, objdir)


def _main(iso, H, P2D, out, phase, objdir):
    if phase == "2":   # 판별력 대조(리허설): 같은 검사기로 committed phase2-dod.md N6.3 수치를 재현하는지(H = 5f643a9, P2D 자리 = da03c0e)
        p3_cards.PHASE3 = [(i, i, None, "") for i in P2_IDS]

    def git(*a, env=None):
        p = subprocess.run(["git", "-c", "core.quotepath=off", "-C", iso, *a], capture_output=True, env=env)
        return p.returncode, p.stdout.decode("utf-8", "replace")

    real_objs = git("rev-parse", "--path-format=absolute", "--git-path", "objects")[1].strip()
    menv = dict(os.environ, GIT_OBJECT_DIRECTORY=objdir, GIT_ALTERNATE_OBJECT_DIRECTORIES=real_objs)
    mc_cache = {}

    def merge_class(c, paths):
        """(None, []) 보통 커밋 | ('clean', []) 자동 병합과 paths 내용 같음 | ('evil', 다른 경로) merge에서만 바꾼 내용(충돌 해결·부모 3개 이상 포함)."""
        key = (c, tuple(paths))
        if key in mc_cache:
            return mc_cache[key]
        par = git("show", "-s", "--format=%P", c)[1].split()
        if len(par) < 2:
            r = (None, [])
        elif len(par) > 2:
            r = ("evil", ["(부모 %d개)" % len(par)])
        else:
            rc, mt = git("merge-tree", "--write-tree", "--no-messages", par[0], par[1], env=menv)
            if rc not in (0, 1) or not mt.split():
                r = ("evil", ["(merge-tree 실패 rc=%d)" % rc])
            else:
                d = git("diff", "--name-only", mt.split()[0], c, "--", *paths, env=menv)[1].split()
                r = ("evil", d + (["(충돌 병합)"] if rc == 1 and d else [])) if d else ("clean", [])
        mc_cache[key] = r
        return r

    anc = lambda c: bool(c) and git("merge-base", "--is-ancestor", c, H)[0] == 0
    trailers = lambda c: git("show", "-s", "--format=%(trailers:only,unfold)", c)[1]
    res = {"H": H, "P2D": P2D, "phase": phase}
    _, ls = git("ls-tree", "--name-only", H, ".ai/verification/")
    allv = {}
    for p in sorted(ls.split()):
        if p.endswith(".json") and not p.endswith("_schema.json"):
            d = json.loads(git("show", "%s:%s" % (H, p))[1])
            allv[d["id"]] = d
    V = lambda d: {k: d["checks"].get(k, {}).get("verdict") for k in ["V%d" % i for i in range(1, 11)]}
    bad1 = {i: V(d) for i, d in allv.items() if any(x not in ("PASS", "N/A") for x in V(d).values())}
    res["1"] = {"n": len(allv), "bad": bad1, "ok": bool(allv) and not bad1}
    _, cards = git("grep", "-l", "-E", "^phase: %s$" % phase, H, "--", "docs/02-design/specs")
    ids3 = sorted(re.sub(r"^.*/(.*)\.spec\.md$", r"\1", c) for c in cards.split())
    hit = p3_cards.match(p3_cards.PHASE3, ids3)
    listed = {i for v in hit.values() for i in v}
    res["2"] = {"n_cards": len(ids3), "expected": len(p3_cards.PHASE3),
                "per_label": {k: v for k, v in hit.items()},
                "with_record": sorted(i for i in ids3 if i in allv),
                "without_record": sorted(i for i in ids3 if i not in allv),
                "unlisted_phase3_cards": sorted(set(ids3) - listed),
                "labels_missing": sorted(k for k, v in hit.items() if len(v) != 1)}
    res["2"]["ok"] = (not res["2"]["without_record"] and not res["2"]["unlisted_phase3_cards"]
                      and not res["2"]["labels_missing"])
    merges = collections.defaultdict(list)
    for ln in git("log", "--merges", "--format=%H%x09%s", H)[1].splitlines():
        h, s = ln.split("\t", 1)
        m = re.match(r"^merge (\S+)$", s)
        if m:
            merges[m.group(1)].append(h)

    def row_of(lab, i, ev):
        d = allv[i]
        a = git("log", "-1", "--format=%H", H, "--", ".ai/verification/%s.json" % i)[1].strip()
        tr = trailers(a)
        par = git("show", "-s", "--format=%P", a)[1].split()
        mc = merges.get(i, [])
        et = d.get("evidence_type")
        if et == "test-only":
            merge_ok = not mc and d.get("code_commit") is None and par == [d.get("test_commit")]
        else:
            merge_ok = len(mc) == 1 and anc(mc[0])
        return {"label": lab, "id": i, "evidence_type": et, "design_evidence": ev,
                "V": "".join("P" if x == "PASS" else ("N" if x == "N/A" else "X") for x in V(d).values()),
                "audit_commit": a[:7], "audit_trailers_ok": ("Role: audit" in tr and ("Change-Id: %s" % i) in tr and anc(a)),
                "merge_commits": [m[:7] for m in mc], "merge_ok": merge_ok,
                "base_test_code_anc": all(anc(c) for c in (d.get("base_commit"), d.get("test_commit"), d.get("code_commit")) if c),
                "red_n": [len((d.get("red") or {}).get("test_ids") or []), len((d.get("red") or {}).get("failure_hashes") or [])],
                "V2_verdict": d["checks"].get("V2", {}).get("verdict"),
                "V2_basis_head": (d["checks"].get("V2", {}).get("basis") or "")[:300]}

    rows = []
    for lab, rx, ev, _sup in p3_cards.PHASE3:
        ids = hit[lab]
        if len(ids) != 1 or ids[0] not in allv:
            rows.append({"label": lab, "id": ids, "missing": True})
            continue
        rows.append(row_of(lab, ids[0], ev))
    res["3_rows"] = rows
    res["3"] = {"ok": bool(rows) and all(r.get("audit_trailers_ok") and r.get("merge_ok") and r.get("base_test_code_anc")
                                         for r in rows) and not any(r.get("missing") for r in rows),
                "missing_rows": [r["label"] for r in rows if r.get("missing")]}
    p3ids = {r["id"] for r in rows if not r.get("missing")}
    # --no-merges 없음(nomerge, 2026-10-06 사용자 승인): 남은 merge 중 clean은 빼고 evil만 대조한다(docstring)
    cs_all = git("log", "--format=%H", "%s..%s" % (P2D, H), "--", *ENGINE)[1].split()
    cs = []; merges_clean = []
    for c in cs_all:
        k, dp = merge_class(c, ENGINE)
        if k == "clean":
            merges_clean.append(c[:7])
        else:
            cs.append(c)
    per = collections.Counter(); badc = []
    for c in cs:
        tr = trailers(c)
        role = re.search(r"^Role: (\S+)", tr, re.M); cid = re.search(r"^Change-Id: (\S+)", tr, re.M)
        k, dp = merge_class(c, ENGINE)   # 여기 남은 merge는 evil뿐 -- 역할 커밋은 merge가 아니므로(병합은 오케스트레이터) trailer와 무관하게 bad
        if not k and role and role.group(1) in ("code", "test") and cid and cid.group(1) in p3ids:
            per["%s %s" % (cid.group(1), role.group(1))] += 1
        else:
            badc.append({"c": c[:7], "role": role and role.group(1), "cid": cid and cid.group(1),
                         **({"merge": k, "merge_only_paths": dp} if k else {})})
    # 덮음 대조(r1, review §4-c): 목록 card의 test_commit·code_commit 중 엔진 경로를 바꾼 것은 4번 목록에 있어야 한다
    cs_set = set(cs); cover = []
    for r in rows:
        if r.get("missing"):
            continue
        d = allv[r["id"]]
        for kind in ("test_commit", "code_commit"):
            c = d.get(kind)
            if not c:
                continue
            touched = git("diff-tree", "--no-commit-id", "--name-only", "-r", c, "--", *ENGINE)[1].split()
            st = "in_list" if c in cs_set else ("outside_engine_paths" if not touched else "MISSING_FROM_LIST")
            cover.append({"label": r["label"], "kind": kind, "c": c[:7], "engine_paths_touched": len(touched), "status": st})
    cover_bad = [x for x in cover if x["status"] == "MISSING_FROM_LIST"]
    pend4 = len(cs) == 0
    res["4"] = {"range": "%s..%s" % (P2D[:7], H[:7]), "pathspec": ENGINE, "n": len(cs), "merges_clean": merges_clean,
                "per_card_role": dict(per),
                "bad": badc, "cover": cover, "cover_bad": cover_bad,
                "pending": pend4, "ok": (not pend4) and not badc and not cover_bad}
    ev5 = {}
    for r in rows:
        if r.get("missing"):
            continue
        if r["evidence_type"] == "red-green":
            ev5[r["label"]] = {"red_n": r["red_n"], "V2": r["V2_verdict"], "ok": min(r["red_n"]) > 0 and r["V2_verdict"] == "PASS"}
        elif r["evidence_type"] == "test-only":
            roles = {k.split()[1] for k in per if k.split()[0] == r["id"]}
            ev5[r["label"]] = {"roles_in_4": sorted(roles), "ok": roles == {"test"}}
        else:
            basis = r["V2_basis_head"].strip()
            ev5[r["label"]] = {"V2": r["V2_verdict"], "basis_head": basis or "근거 문장 없음",
                               "quote_check": "auditor가 base = 병합본 문장 인용인지 확인" if basis else None,
                               "ok": r["V2_verdict"] == "PASS" and bool(basis)}
    res["5"] = {"per_card": ev5, "ok": bool(ev5) and all(v["ok"] for v in ev5.values()) and not res["3"]["missing_rows"]}
    # 관찰(판정 아님)
    g05 = p3_cards.match(p3_cards.GATE05, list(allv))
    res["obs_gate05"] = {lab: (row_of(lab, v[0], None) if len(v) == 1 else None) for lab, v in g05.items()}
    gcs = git("log", "--format=%H", "%s..%s" % (P2D, H), "--", "tools/gates")[1].split()   # --no-merges 없음(nomerge): clean merge는 뺀다
    res["obs_tools_gates"] = [dict({"c": c[:7], "trailers": re.findall(r"^(?:Role|Change-Id): \S+", trailers(c), re.M)},
                                   **({"merge": k, "merge_only_paths": dp} if k else {}))
                              for c in gcs for k, dp in [merge_class(c, ["tools/gates"])] if k != "clean"]
    json.dump(res, open(out, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    print("N6.3 1 %s(n=%d) | 2 %s(%d/%d, 기록 없음 %d) | 3 %s | 4 %s(n=%d, 어긋남 %d, 덮음 누락 %d, 경로 밖 %d) | 5 %s" % (
        verdict_str(res["1"]["ok"]), res["1"]["n"], verdict_str(res["2"]["ok"]), res["2"]["n_cards"], res["2"]["expected"],
        len(res["2"]["without_record"]), verdict_str(res["3"]["ok"]), verdict_str(res["4"]["ok"], pend4), res["4"]["n"], len(badc),
        len(cover_bad), sum(1 for x in cover if x["status"] == "outside_engine_paths"), verdict_str(res["5"]["ok"])))
    print("N6.3 관찰 0.5 card: " + " | ".join("%s %s" % (lab, ("없음" if v is None else "%s V=%s audit=%s merge=%s" % (
        v["id"], v["V"], v["audit_trailers_ok"], v["merge_ok"]))) for lab, v in res["obs_gate05"].items()))


if __name__ == "__main__":
    sys.stdout.reconfigure(encoding="utf-8")
    main(*sys.argv[1:6])
