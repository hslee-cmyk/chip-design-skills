#!/usr/bin/env bash
# 공격 32(측정판) 한 번 실행: $1 = scratch(C:/g<n>), $2 = 복제본(b|p), $3 = 이름표, $4 = G1_VARIANT(없으면 "-")
# 결과: g1_kit/out/a32_<이름표>.jsonl(run_all 로그 사본) + .txt(표준 출력). TMP는 scratch 아래(실제 저장소·다른 C:/g* 무관).
set -euo pipefail
S="$1"; C="$2"; L="$3"; V="${4:--}"
K=C:/Users/HSLEE/Documents/Todoc/fpga/wt/_drafts/g1_kit
PY=C:/Python314/python.exe
case "$S" in C:/g*) ;; *) echo "scratch must be C:/g<n>"; exit 2;; esac
mkdir -p "$S/tmp_$L" "$K/out"
export TMP="$S/tmp_$L" TEMP="$S/tmp_$L" TMPDIR="$S/tmp_$L"
export G1_SCOPE=1 G1_SCOPE_DIR=C:/Users/HSLEE/Documents/Todoc/fpga/wt/_drafts/v3scope_kit
if [ "$V" != "-" ]; then export G1_VARIANT="$V"; else unset G1_VARIANT || true; fi
set +e
"$PY" -B "$S/$C/tools/gates/redteam/run_all.py" --phase 0.5 --mode direct --only 32-moved-defs --repo "$S/$C" > "$K/out/a32_$L.txt" 2>&1
rc=$?
set -e
LOG=$(ls -t "$S/$C/tools/gates/redteam/logs/"*-direct.jsonl | head -1)
cp "$LOG" "$K/out/a32_$L.jsonl"
echo "exit $rc log $LOG" >> "$K/out/a32_$L.txt"
