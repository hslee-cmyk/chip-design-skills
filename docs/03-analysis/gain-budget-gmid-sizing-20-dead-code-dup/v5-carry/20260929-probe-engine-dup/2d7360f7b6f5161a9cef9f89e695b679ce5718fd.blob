"""Phase 2 P4 계약: probe 안 엔진 식 재구현 스캐너 `A/tests/tools/probe_dup_scan.py`(20260929-probe-engine-dup).

spec card `docs/02-design/specs/20260929-probe-engine-dup.spec.md`(재시도 개정판) 계약 1·2를 판정한다. 정본 명세는 design
`gain-budget-gmid-sizing.20-dead-code-dup` §2.2-4·§3 PROBE-DUP·§5·§8 P4. 신규 시그니처(interface card):

* `scan_source(source: str, path: str) -> list` -- 발견 한 건 = `{"path", "line", "rule", "concept", "exempt"}`
* `main(argv: list) -> int` -- `--root <저장소 루트>`로 `A/tests/probes/**/*.py`를 훑어 발견을 한 줄 JSON씩 출력(`path`는 루트
  기준 상대 경로, `/` 구분). 면제되지 않은 발견이 0이면 0, 1개 이상이면 1, 입력 오류(없는 루트·구문 오류 파일)는 2.
* 규칙 5종(`lut-private`·`diode-inline`·`mirror-key`·`gate-source-share`·`rail-set`). '접근'은 `.gate`·`["gate"]`·`.get("gate")` 셋 다.
* 면제: `<root>/.ai/approvals/*.md`(이름이 `_`로 시작하지 않는 것) 중 머리 블록에 `target_kind: decision`이 있는 기록의 `target:`
  원소(`,` 구분) `<path>::<rule>`과 같은 발견은 `"exempt": true`이고 exit 판정에서 빠진다.

스캐너는 base에 없으므로 이 파일은 base에서 수집 단계 ImportError(red)이고, 스캐너를 더한 병합본에서 green이다.
계약 3(probe 출력 보존)은 실행 비교라 auditor가 base와 병합본을 돌려 본다 -- 여기서 기대 출력을 박지 않는다.

oracle 대조(계획 N3.12.3):

* test_rule_finds_synthetic_reimplementation[*] -- (a) 합성 소스: 규칙 5종마다 계약 1 규칙 문장의 모양(세 가지 접근 형태 포함)을
  손으로 만든 조각이다. 기대값(규칙 이름·줄 번호)은 조각을 쓴 방식으로 정해진다 -- 그 모양을 적은 줄이 곧 기대 줄이다.
* test_rule_ignores_non_reimplementation[*] -- (a) 합성 소스: 계약 1 규칙 문장과 spec card '거부해야 할 입력'이 발견이 아니라고 정한
  모양(주석·문자열 속 같은 글자, `gate_bias`·`source_file` 같은 다른 이름, 데이터 속성 `_log_ID`·`_grids_list` 읽기, 정해진 VGS의
  W = L·ID/IDu 식, 일반 union-find, `or`, 원소 하나뿐인 집합 등). 기대값은 '발견 0'이다.
* test_canonical_calls_are_not_findings -- (a) 합성 소스: 계약 2의 정본 호출과 레일 상수만 쓰는 조각. 기대값 '발견 0'.
* test_finding_record_fields -- (a) 합성 소스 한 조각의 발견 한 건이 계약 1의 다섯 키를 갖고 path가 넘긴 값인지.
* test_main_* -- (a) 합성 루트(tmp_path): probes/ 아래 파일과 `.ai/approvals/` 기록을 구성으로 정해 exit 0/1/2와 exempt가 정해진다.
* test_main_on_this_repository_is_clean -- 계약 2 PROBE-DUP: 이 저장소(병합본) 루트에서 면제되지 않은 발견 0, exit 0. 기대값은
  spec card 계약 2 문장이다(실제 면제 기록 `.ai/approvals/20260929-p4-scan-exempt.md`는 병합본 base에 있다).

판정하지 않은 것(규칙 문장이 정하지 않음): `concept` 문자열의 값, 머리 블록 밖 `target:` 줄의 취급.
"""
import json
import pathlib
import sys

import pytest

# contracts -> tests -> assets(A) -> analog-gmid-design -> skills -> 저장소 루트
_TESTS_DIR = pathlib.Path(__file__).resolve().parents[1]
_ASSETS_DIR = _TESTS_DIR.parent
_REPO_ROOT = _ASSETS_DIR.parents[2]
_TOOLS_DIR = _TESTS_DIR / "tools"
_PROBES_REL = pathlib.PurePosixPath("skills", "analog-gmid-design", "assets", "tests", "probes")

if str(_TOOLS_DIR) not in sys.path:
    sys.path.insert(0, str(_TOOLS_DIR))

import probe_dup_scan  # noqa: E402  (base에 없다 -- red의 근원)

_RULES = ("lut-private", "diode-inline", "mirror-key", "gate-source-share", "rail-set")
_RECORD_KEYS = {"path", "line", "rule", "concept", "exempt"}
_SYNTH_PATH = "synthetic_probe.py"


def _scan(source):
    return probe_dup_scan.scan_source(source, _SYNTH_PATH)


def assert_finds(source, rule, line):
    """`source`에서 규칙 `rule`의 발견이 `line`줄에 있어야 한다(다른 규칙 발견이 함께 있어도 된다)."""
    found = _scan(source)
    assert isinstance(found, list), f"scan_source는 list를 돌려준다(계약 1): {type(found)!r}"
    hits = [(f["rule"], f["line"]) for f in found]
    assert (rule, line) in hits, f"규칙 {rule} {line}행 발견이 없다: {hits}\n--- source ---\n{source}"


def assert_no_findings(source):
    """`source`에서 발견이 하나도 없어야 한다(오탐 없음)."""
    found = _scan(source)
    assert isinstance(found, list), f"scan_source는 list를 돌려준다(계약 1): {type(found)!r}"
    assert found == [], f"발견이 없어야 한다: {found}\n--- source ---\n{source}"


# ---------------------------------------------------------------------------------------------------------------
# 규칙마다 발견해야 할 합성 조각: (id, rule, source, 기대 줄). 기대 줄 = 그 모양을 적은 줄(구성으로 정해진다).
# ---------------------------------------------------------------------------------------------------------------
_POSITIVE = [
    # lut-private: 어떤 객체든 메서드 `._query(...)`·`._w_ref_effective(...)` 호출.
    ("lut-private/_query", "lut-private",
     "import math\n"
     "def idu(lut, vgs, L, vds, vsb):\n"
     "    raw = math.exp(lut._query(lut._log_ID, L, vgs, vds, vsb))\n"
     "    return raw\n", 3),
    ("lut-private/_w_ref_effective", "lut-private",
     "def scale(table, L):\n"
     "    return L / table._w_ref_effective(L)\n", 2),
    ("lut-private/other-object", "lut-private",
     "x = LUT['nmos']._query(arr, 1e-6, 0.5, 0.5, 0.0)\n", 1),
    # diode-inline: gate 접근과 drain 접근을 == / != 로 비교(속성·첨자·.get 셋 다).
    ("diode-inline/attr-eq", "diode-inline",
     "diodes = [t.name for t in trs if t.gate == t.drain]\n", 1),
    ("diode-inline/subscript-ne", "diode-inline",
     "for dv in netlist:\n"
     "    if dv[\"gate\"] != dv[\"drain\"]:\n"
     "        continue\n", 2),
    ("diode-inline/get", "diode-inline",
     "diodes = [dv[\"name\"] for dv in ds if dv.get(\"gate\") == dv.get(\"drain\")]\n", 1),
    ("diode-inline/drain-first-mixed", "diode-inline",
     "flag = \"diode\" if (t.drain == d.get(\"gate\")) else \"\"\n", 1),
    # mirror-key: 한 튜플 리터럴 안에 gate 접근과 source 접근.
    ("mirror-key/attr", "mirror-key",
     "import collections\n"
     "g = collections.defaultdict(list)\n"
     "for t in trs:\n"
     "    g[(t.gate, t.source, t.kind)].append(t.name)\n", 4),
    ("mirror-key/subscript", "mirror-key",
     "key = (dv[\"source\"], dv[\"gate\"])\n", 1),
    ("mirror-key/get", "mirror-key",
     "for dv in topo[\"netlist\"]:\n"
     "    g[(dv.get(\"gate\"), dv.get(\"source\"), dv.get(\"kind\"))].append(dv)\n", 2),
    # gate-source-share: 한 and 안에 gate 접근끼리 비교와 source 접근끼리 비교.
    ("gate-source-share/attr", "gate-source-share",
     "same = a.gate == b.gate and a.source == b.source\n", 1),
    ("gate-source-share/with-extra-operand", "gate-source-share",
     "if a.kind == b.kind and a.source == b.source and a.gate == b.gate:\n"
     "    pass\n", 1),
    ("gate-source-share/get-and-subscript", "gate-source-share",
     "same = a.get(\"gate\") == b[\"gate\"] and a.get(\"source\") == b[\"source\"]\n", 1),
    # rail-set: 문자열 상수 2개 이상으로 된 집합·리스트·튜플 리터럴, 원소가 모두 대소문자 무시 레일 이름 후보.
    ("rail-set/set", "rail-set",
     "RAILS_HI = {\"vdd\", \"VDD\"}\n", 1),
    ("rail-set/list", "rail-set",
     "lo = [\"gnd\", \"GND\", \"vss\", \"VSS\"]\n", 1),
    ("rail-set/tuple-mixed-case", "rail-set",
     "RAILS = (\"AVDD\", \"agnd\", \"Dvss\", \"dvdd\", \"avss\")\n", 1),
]


@pytest.mark.parametrize("rule,source,line", [p[1:] for p in _POSITIVE], ids=[p[0] for p in _POSITIVE])
def test_rule_finds_synthetic_reimplementation(rule, source, line):
    # oracle (a): 조각은 계약 1 규칙 문장의 모양대로 손으로 만들었다 -- 기대 규칙·줄은 구성으로 정해진다.
    assert rule in _RULES
    assert_finds(source, rule, line)


def test_every_rule_has_a_positive_case():
    # oracle (a): 계약 1의 규칙 5종 전부가 위 표에서 발견 케이스를 가진다(규칙 하나라도 빠지면 판정이 공허하다).
    assert {p[1] for p in _POSITIVE} == set(_RULES)


# ---------------------------------------------------------------------------------------------------------------
# 발견하면 안 되는 합성 조각: (id, source). 기대 = 발견 0.
# ---------------------------------------------------------------------------------------------------------------
_NEGATIVE = [
    # 주석·문자열 속 같은 글자(spec card '거부해야 할 입력').
    ("comment-and-string/all-rules",
     "# lut._query(lut._log_ID, L, vgs, vds, vsb) ; lut._w_ref_effective(L)\n"
     "# if t.gate == t.drain: key = (t.gate, t.source)\n"
     "# RAILS = {'vdd', 'gnd'}\n"
     "DOC = \"\"\"lut._query(a) ; t.gate == t.drain ; (t.gate, t.source) ; dv.get('gate') == dv.get('drain')\n"
     "a.gate == b.gate and a.source == b.source ; {'vdd', 'gnd'}\"\"\"\n"
     "MSG = \"lut._w_ref_effective(L)\"\n"),
    # lut-private: 데이터 속성 _log_ID·_grids_list 읽기만(probe_interp_scheme_loo 모양 -- 계약 1이 발견 아님으로 명시).
    ("lut-private/data-attribute-read",
     "arr = lut._log_ID\n"
     "grids = lut._grids_list\n"
     "shape = (len(lut._grids_list), lut._log_ID.shape)\n"
     "y = sr._multilinear_interp(lut._grids_list, lut._log_ID, pt)\n"),
    # lut-private: 이름이 다른 메서드는 규칙의 두 이름이 아니다.
    ("lut-private/other-method-name",
     "v = lut._query_cache(1)\n"
     "w = lut.query(1)\n"
     "z = lut._w_ref(1)\n"),
    # diode-inline: 다른 이름(gate_bias·drain_net), gate와 source 비교, 비교 연산이 아닌 것.
    ("diode-inline/other-names",
     "a = t.gate_bias == t.drain_net\n"
     "b = t.gate == t.source\n"
     "c = t.gate < t.drain\n"
     "d = dv[\"gate_bias\"] != dv[\"drain_net\"]\n"
     "e = dv.get(\"gate_bias\") == dv.get(\"drain_net\")\n"),
    # mirror-key: gate만 있는 튜플, 다른 이름(gate_bias·source_file), source만 있는 튜플.
    ("mirror-key/other-names",
     "k1 = (t.gate, t.kind)\n"
     "k2 = (t.gate_bias, t.source_file)\n"
     "k3 = (t.source, t.drain)\n"
     "k4 = (dv.get(\"gate_bias\"), dv.get(\"source_file\"))\n"),
    # gate-source-share: or 연산, gate만 비교, 다른 이름.
    ("gate-source-share/not-and",
     "x = a.gate == b.gate or a.source == b.source\n"
     "y = a.gate == b.gate and a.kind == b.kind\n"
     "z = a.gate_bias == b.gate_bias and a.source_file == b.source_file\n"),
    # 정해진 VGS의 W = L·ID/IDu 식(개정 spec card: 재구현 아님 -- 규칙에서 뺐다).
    ("fixed-vgs-width-formula",
     "idu = lut.id_density_at_vgs(vgs, L, vds, vsb)\n"
     "W = L * ID / idu\n"
     "w_um = L * i[\"ID\"] * id_scale / IDu * 1e6\n"),
    # 일반 union-find(개정 spec card: 재구현 아님 -- 규칙에서 뺐다).
    ("generic-union-find",
     "parent = {n: n for n in names}\n"
     "def find(x):\n"
     "    while parent[x] != x:\n"
     "        parent[x] = parent[parent[x]]; x = parent[x]\n"
     "    return x\n"),
    # rail-set: 원소 하나, 레일이 아닌 원소 섞임, 딕셔너리 리터럴(집합·리스트·튜플이 아님).
    ("rail-set/not-all-rails",
     "a = {\"vdd\"}\n"
     "b = {\"vdd\", \"out\"}\n"
     "c = [\"vddx\", \"gndy\"]\n"
     "d = {\"vdd\": 1.8, \"gnd\": 0.0}\n"),
]


@pytest.mark.parametrize("source", [n[1] for n in _NEGATIVE], ids=[n[0] for n in _NEGATIVE])
def test_rule_ignores_non_reimplementation(source):
    # oracle (a): 계약 1 규칙 문장과 spec card '거부해야 할 입력'이 발견이 아니라고 정한 모양 -- 기대 발견 0.
    assert_no_findings(source)


def test_canonical_calls_are_not_findings():
    # oracle (a): 계약 2가 정한 정본과 레일 상수만 쓰는 조각 -- 재구현이 없으므로 기대 발견 0.
    source = (
        "import sizing_recipe as sr\n"
        "diode = {n for n, t in by.items() if sr.is_diode_connected(t)}\n"
        "groups = sr.true_current_mirror_groups(by)\n"
        "res = sr.size_transistor(gm, gm_id, L, lut, vds, vsb)\n"
        "W = res.W\n"
        "idu = lut.id_density_at_vgs(vgs, L, vds, 0.0)\n"
        "supply = sr._metric_supply_current({}, ctx)\n"
        "rails = sr._DEFAULT_RAIL_HI | sr._DEFAULT_RAIL_LO\n"
        "hi = t.source in sr._DEFAULT_RAIL_HI\n"
    )
    assert_no_findings(source)


def test_finding_record_fields():
    # oracle (a): 발견 한 건은 계약 1의 다섯 키를 갖고, path는 넘긴 값이다. scan_source는 승인 기록을 읽지 않으므로 면제가 아니다.
    found = probe_dup_scan.scan_source("d = t.gate == t.drain\n", "some/dir/probe_z.py")
    assert len(found) == 1, found
    rec = found[0]
    assert set(rec) == _RECORD_KEYS, rec
    assert rec["path"] == "some/dir/probe_z.py"
    assert rec["line"] == 1
    assert rec["rule"] == "diode-inline"
    assert isinstance(rec["concept"], str) and rec["concept"].strip()
    assert rec["exempt"] is False


def test_findings_on_separate_lines_are_all_reported():
    # oracle (a): 서로 다른 줄의 재구현 둘 -- 둘 다 보고된다(첫 발견에서 멈추지 않는다).
    source = ("RAILS = {\"vdd\", \"gnd\"}\n"
              "d = t.gate == t.drain\n")
    found = _scan(source)
    assert {(f["rule"], f["line"]) for f in found} >= {("rail-set", 1), ("diode-inline", 2)}, found


# ---------------------------------------------------------------------------------------------------------------
# main(argv): 합성 루트
# ---------------------------------------------------------------------------------------------------------------
def _make_root(tmp_path, files):
    """tmp_path를 저장소 루트로 삼아 `{루트 기준 상대경로: 내용}`을 쓴다."""
    for rel, text in files.items():
        p = tmp_path.joinpath(*pathlib.PurePosixPath(rel).parts)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")
    return tmp_path


def _probe(name):
    return str(_PROBES_REL / name)


def _approval(target_kind, target):
    """`.ai/approvals/*.md` 기록 한 건(머리 블록 + 본문). 형식은 실제 기록(`20260929-p4-scan-exempt.md`)의 머리를 따른다."""
    return ("---\n"
            "id: synthetic\n"
            "date: 2026-09-29\n"
            f"target_kind: {target_kind}\n"
            f"target: {target}\n"
            "scope: synthetic\n"
            "---\n"
            "\n"
            "## 사용자 원문\n"
            "\n"
            "> synthetic\n")


def _json_lines(text):
    return [json.loads(ln) for ln in text.splitlines() if ln.strip()]


def _run_main(root, capsys):
    rc = probe_dup_scan.main(["--root", str(root)])
    return rc, _json_lines(capsys.readouterr().out)


_P_A = _probe("probe_a.py")                   # diode-inline 한 건(2행)
_SRC_A = "x = 1\nd = t.gate == t.drain\n"


def test_main_exit_0_when_probes_are_clean(tmp_path, capsys):
    # oracle (a): probes/에 정본 호출만 있는 파일 -- 발견 0, exit 0, 발견 줄 출력 없음.
    root = _make_root(tmp_path, {
        _probe("probe_clean.py"): "import sizing_recipe as sr\nd = sr.is_diode_connected(t)\n",
    })
    rc, recs = _run_main(root, capsys)
    assert rc == 0
    assert recs == []


def test_main_exit_1_and_json_lines_on_findings(tmp_path, capsys):
    # oracle (a): probes/ 바로 아래와 하위 디렉터리(`**`)에 재구현 하나씩 -- exit 1, 발견마다 한 줄 JSON,
    # path는 루트 기준 상대 경로(`/` 구분).
    root = _make_root(tmp_path, {
        _P_A: _SRC_A,
        _probe("sub/probe_b.py"): "RAILS = {\"vdd\", \"gnd\"}\n",
        _probe("probe_ok.py"): "y = 2\n",
    })
    rc, recs = _run_main(root, capsys)
    assert rc == 1
    assert all(set(r) == _RECORD_KEYS for r in recs), recs
    got = {(r["path"], r["line"], r["rule"], r["exempt"]) for r in recs}
    assert got == {(_P_A, 2, "diode-inline", False),
                   (_probe("sub/probe_b.py"), 1, "rail-set", False)}, recs


def test_main_ignores_files_outside_probes(tmp_path, capsys):
    # oracle (a): 계약 1 범위는 `A/tests/probes/**/*.py`다 -- unit/·tools/·A 바로 아래의 재구현은 훑지 않는다.
    root = _make_root(tmp_path, {
        _probe("probe_clean.py"): "z = 3\n",
        "skills/analog-gmid-design/assets/tests/unit/test_x.py": "RAILS = {\"vdd\", \"gnd\"}\n",
        "skills/analog-gmid-design/assets/tests/tools/tool_x.py": "d = t.gate == t.drain\n",
        "skills/analog-gmid-design/assets/engine_x.py": "RAILS = {\"vdd\", \"gnd\"}\n",
    })
    rc, recs = _run_main(root, capsys)
    assert rc == 0
    assert recs == []


def test_main_ignores_non_python_files_in_probes(tmp_path, capsys):
    # oracle (a): 대상은 `*.py`뿐 -- probes/ 안의 결과 텍스트 파일에 같은 글자가 있어도 발견이 아니다.
    root = _make_root(tmp_path, {
        _probe("probe_clean.py"): "z = 3\n",
        _probe("probe_clean.result.txt"): "d = t.gate == t.drain\n",
    })
    rc, recs = _run_main(root, capsys)
    assert rc == 0
    assert recs == []


def test_main_exit_2_on_syntax_error_file(tmp_path):
    # oracle (a): 계약 1 '입력 오류(구문 오류 파일)는 2'. 다른 파일에 발견이 있을 때의 우선순위는 정하지 않았으므로 그 파일 하나만 둔다.
    root = _make_root(tmp_path, {
        _probe("probe_broken.py"): "def f(:\n    pass\n",
    })
    assert probe_dup_scan.main(["--root", str(root)]) == 2


def test_main_exit_2_on_missing_root(tmp_path):
    # oracle (a): 계약 1 '입력 오류(없는 루트)는 2'.
    missing = tmp_path / "no_such_root"
    assert not missing.exists()
    assert probe_dup_scan.main(["--root", str(missing)]) == 2


# ---- 면제(계약 1 '면제', spec card '거부해야 할 입력') ----------------------------------------------------------
def test_main_decision_target_exempts_matching_finding(tmp_path, capsys):
    # oracle (a): target이 그 파일·그 규칙을 정확히 가리키는 decision 기록 -- 발견은 exempt:true로 출력되고 exit 0.
    root = _make_root(tmp_path, {
        _P_A: _SRC_A,
        ".ai/approvals/20260929-synthetic.md": _approval("decision", f"{_P_A}::diode-inline"),
    })
    rc, recs = _run_main(root, capsys)
    assert {(r["path"], r["line"], r["rule"], r["exempt"]) for r in recs} == {(_P_A, 2, "diode-inline", True)}, recs
    assert rc == 0


def test_main_decision_target_list_element_exempts(tmp_path, capsys):
    # oracle (a): target 값은 `,`로 나눈 원소다 -- 다른 원소와 함께 적힌 맞는 원소도 면제한다.
    other = _probe("probe_other.py")
    root = _make_root(tmp_path, {
        _P_A: _SRC_A,
        ".ai/approvals/20260929-synthetic.md": _approval("decision", f"{other}::rail-set, {_P_A}::diode-inline"),
    })
    rc, recs = _run_main(root, capsys)
    assert [r["exempt"] for r in recs] == [True], recs
    assert rc == 0


def test_main_target_for_other_file_does_not_exempt(tmp_path, capsys):
    # oracle (a): target이 다른 파일을 가리키면 면제되지 않는다(spec card '거부해야 할 입력') -- exit 1.
    root = _make_root(tmp_path, {
        _P_A: _SRC_A,
        ".ai/approvals/20260929-synthetic.md": _approval("decision", f"{_probe('probe_other.py')}::diode-inline"),
    })
    rc, recs = _run_main(root, capsys)
    assert [r["exempt"] for r in recs] == [False], recs
    assert rc == 1


def test_main_target_for_other_rule_does_not_exempt(tmp_path, capsys):
    # oracle (a): target이 같은 파일의 다른 규칙을 가리키면 면제되지 않는다 -- exit 1.
    root = _make_root(tmp_path, {
        _P_A: _SRC_A,
        ".ai/approvals/20260929-synthetic.md": _approval("decision", f"{_P_A}::lut-private"),
    })
    rc, recs = _run_main(root, capsys)
    assert [r["exempt"] for r in recs] == [False], recs
    assert rc == 1


def test_main_non_decision_record_does_not_exempt(tmp_path, capsys):
    # oracle (a): `target_kind: decision`이 아닌 기록의 target은 면제가 아니다 -- exit 1.
    root = _make_root(tmp_path, {
        _P_A: _SRC_A,
        ".ai/approvals/20260929-synthetic.md": _approval("test", f"{_P_A}::diode-inline"),
    })
    rc, recs = _run_main(root, capsys)
    assert [r["exempt"] for r in recs] == [False], recs
    assert rc == 1


def test_main_underscore_record_is_not_read(tmp_path, capsys):
    # oracle (a): 이름이 `_`로 시작하는 기록은 읽지 않는다 -- 맞는 target이 있어도 면제가 아니다, exit 1.
    root = _make_root(tmp_path, {
        _P_A: _SRC_A,
        ".ai/approvals/_template.md": _approval("decision", f"{_P_A}::diode-inline"),
    })
    rc, recs = _run_main(root, capsys)
    assert [r["exempt"] for r in recs] == [False], recs
    assert rc == 1


def test_main_partial_exemption_still_exits_1(tmp_path, capsys):
    # oracle (a): 한 파일에 발견 둘(diode-inline 2행, rail-set 3행) 중 하나만 면제 -- 남은 하나 때문에 exit 1.
    root = _make_root(tmp_path, {
        _P_A: _SRC_A + "RAILS = {\"vdd\", \"gnd\"}\n",
        ".ai/approvals/20260929-synthetic.md": _approval("decision", f"{_P_A}::diode-inline"),
    })
    rc, recs = _run_main(root, capsys)
    assert {(r["line"], r["rule"], r["exempt"]) for r in recs} == {(2, "diode-inline", True),
                                                                  (3, "rail-set", False)}, recs
    assert rc == 1


# ---- 실제 저장소(계약 2 PROBE-DUP) --------------------------------------------------------------------------------
def test_main_on_this_repository_is_clean(capsys):
    # 계약 2: 병합본 루트에서 면제되지 않은 발견 0, exit 0. 판정이 공허하지 않도록 probes/에 .py가 실제로 있는지도 본다.
    probes_dir = _REPO_ROOT.joinpath(*_PROBES_REL.parts)
    assert any(probes_dir.rglob("*.py")), f"probes/에 .py가 없다: {probes_dir}"
    rc, recs = _run_main(_REPO_ROOT, capsys)
    assert [r for r in recs if not r.get("exempt")] == [], recs
    assert rc == 0
