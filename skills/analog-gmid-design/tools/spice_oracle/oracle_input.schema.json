{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "spice_oracle_input/2",
 "title": "SPICE 오라클 입력 (spice_oracle_input/2, card OP-3, design §11.1 이 정본)",
 "description": "오라클 입력 JSON. 단위 SI. 닫힌 키 집합(표에 없는 키는 거부, 예외 provenance). 시뮬레이터·PDK 결합은 process.descriptor(오라클 기술자) 와 simulator.adapter 가 정한다. 옛 형식 표지(design §11.2 1b)는 이 스키마 앞에서 oracle_input_format_old 로 거부된다(이중 지원 없음).",
 "type": "object",
 "required": [
  "schema",
  "circuit",
  "process",
  "simulator",
  "rails",
  "devices",
  "ports",
  "predictions",
  "testbench"
 ],
 "properties": {
  "schema": {
   "const": "spice_oracle_input/2"
  },
  "circuit": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
   "description": "회로 식별자(출력 파일 이름 줄기). 경로 구분자·드라이브·예약 문자·공백·앞의 '.' 금지"
  },
  "process": {
   "type": "object",
   "required": [
    "descriptor",
    "lut_files"
   ],
   "additionalProperties": false,
   "properties": {
    "descriptor": {
     "type": "object",
     "required": [
      "path",
      "sha256"
     ],
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$",
       "description": "기술자 파일의 LF 정규화 sha256"
      }
     },
     "description": "오라클 기술자(oracle_pdk_descriptor/1) 참조. 경로는 절대 또는 입력 파일 폴더 기준"
    },
    "lut_files": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "path",
       "sha256",
       "kinds"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "LUT 파일 raw sha256"
       },
       "kinds": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
         "type": [
          "string",
          "null"
         ]
        },
        "description": "devices[].kind -> meta model_files_sha256 의 키(평탄 표면 null)"
       }
      }
     },
     "description": "이 설계점의 소자 DC 동작점을 정한 LUT 슬라이스 파일"
    },
    "corner": {
     "type": "string"
    },
    "temp_c": {
     "type": "number"
    }
   }
  },
  "rails": {
   "type": "array",
   "minItems": 1,
   "description": "레일 넷과 전압. reference=true 인 것이 정확히 하나(SPICE 노드 0). 나머지는 이상 전압원 Vrail_<net>.",
   "items": {
    "type": "object",
    "required": [
     "net",
     "voltage"
    ],
    "properties": {
     "net": {
      "type": "string"
     },
     "voltage": {
      "type": "number"
     },
     "reference": {
      "type": "boolean"
     }
    },
    "additionalProperties": false
   }
  },
  "devices": {
   "type": "array",
   "description": "트랜지스터. 인스턴스 하나 = `X<name> d g s b <subckt> l=L w=finger_w m=n_fingers` (nf 는 쓰지 않는다).",
   "items": {
    "type": "object",
    "required": [
     "name",
     "kind",
     "drain",
     "gate",
     "source",
     "bulk",
     "L",
     "finger_w",
     "n_fingers"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "drain": {
      "type": "string"
     },
     "gate": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "bulk": {
      "type": "string"
     },
     "L": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "finger_w": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "n_fingers": {
      "type": "integer",
      "minimum": 1
     },
     "W": {
      "type": "number",
      "description": "엔진이 선언한 총폭. finger_w*n_fingers 와의 차이는 비교표 W_rel 로 보고(판정은 tolerances.W_rel)."
     },
     "diffusion": {
      "type": "object",
      "description": "[신규 C22] 선택. 이 소자의 확산 기하(Euler 행 공유 확산, 레이아웃 MOD7 ly.diffusion 통계에서 엔진·어댑터가 계산). 값은 finger 하나(= m 단위 하나)당 평균: 소자 전체 드레인 확산 면적 합 / n_fingers 등. 인스턴스는 m=n_fingers 를 유지하므로 시뮬레이터가 m 배 한다. 있으면 기술자 diffusion 규칙보다 우선.",
      "required": [
       "ad_m2",
       "as_m2",
       "pd_m",
       "ps_m"
      ],
      "properties": {
       "ad_m2": {
        "type": "number",
        "minimum": 0
       },
       "as_m2": {
        "type": "number",
        "minimum": 0
       },
       "pd_m": {
        "type": "number",
        "minimum": 0
       },
       "ps_m": {
        "type": "number",
        "minimum": 0
       },
       "basis": {
        "type": "string",
        "description": "출처(예: ly.diffusion 스냅샷 지문)"
       }
      },
      "additionalProperties": false
     }
    },
    "additionalProperties": false
   }
  },
  "sources": {
   "type": "array",
   "description": "이상 전원. current: SPICE I p n(전류가 p 에서 소스를 지나 n 으로), voltage: V p n.",
   "items": {
    "type": "object",
    "required": [
     "name",
     "kind",
     "terminals",
     "value"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "current",
       "voltage"
      ]
     },
     "terminals": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "value": {
      "type": "number"
     },
     "value_basis": {
      "type": "string",
      "description": "값의 근거(표에 그대로 찍힘)"
     },
     "not_in_topology_reason": {
      "type": "string",
      "minLength": 1,
      "description": "[신규] 선택. topology 에 없는 원소(예: spec 부하)라 C15 연결 동일성 비교에서 뺄 때 그 이유. 비교 결과에 그대로 기록된다."
     }
    },
    "additionalProperties": false
   }
  },
  "passives": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "kind",
     "terminals",
     "value"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "resistor",
       "capacitor"
      ]
     },
     "terminals": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "value": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "value_basis": {
      "type": "string"
     },
     "not_in_topology_reason": {
      "type": "string",
      "minLength": 1,
      "description": "[신규] 선택. topology 에 없는 원소(예: spec CL 로 어댑터가 넣은 부하)라 C15 비교에서 뺄 때 그 이유."
     }
    },
    "additionalProperties": false
   }
  },
  "feedback_passives": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "uniqueItems": true,
   "description": "β 되먹임망을 이루는 passives 이름(입력 포트 넷에 물린 되먹임·입력측 소자). 있으면 PM 은 이 β 루프의 위상여유(루프 넷리스트, Middlebrook 이중 주입), 없으면 β=1(개루프 A) 위상여유. README 'PM 정의'. [변경 C14] 원소마다 두 단자 중 입력 포트 넷에 물린 단자가 정확히 1개여야 한다(0개·2개 모두 막힘)."
  },
  "cm_loop_passives": false,
  "cm_output_loop": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "drivers"
   ],
   "properties": {
    "drivers": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "uniqueItems": true,
     "minItems": 1,
     "description": "구동자(x 쪽) MOS 이름 -- 엔진 cm_partition 결과(차동 출력 넷에 channel 단자가 물려 레일에 닿는 출력 단 소자). 각 소자는 drain 또는 source 중 정확히 하나가 출력 넷이어야 한다."
    }
   },
   "description": "[신규 CM] 선택. 있으면 공통 모드 루프를 선언된 차동 출력 포트 쌍(ports.output_p·output_n)에서 끊는다: <stem>.cmloop.cir 에서 drivers 의 출력 넷 쪽 channel 단자를 lbx_<넷> 으로 떼고(수동소자·gate·그 밖 MOS 는 남는다 -- 분할은 엔진이 정해 주입, 오라클은 엔진을 import 하지 않는다) 두 넷에 동일 부호(가중 1/2씩) Middlebrook 전압·전류 이중 주입으로 T_cm 을 잰다(입력은 전부 AC 접지). PM = measure cm_pm_deg. README 'CM 루프 PM'."
  },
  "feedback_passives_basis": {
   "type": "string",
   "minLength": 1,
   "description": "[신규 C12 보충] 선택. feedback_passives 를 정한 규칙(기록 전용, 판정 무관). 옛 어댑터 = 'legacy_c12_input_net_passives'(입력 포트 넷에 물린 passives 전부), 새 엔진 = 'spec_feedback_elements'(spec feedback.elements 그대로). 두 규칙이 다른 집합을 고르면 두 PM 은 다른 루프를 잰 값이다 -- compare.summary.pm_loop 에 그대로 남는다."
  },
  "bias_voltages": {
   "type": "array",
   "description": "구동 소자 없는 게이트 전용 넷에 거는 이상 전압. 선언 안 된 그런 넷은 predictions.nodes 값으로 걸고 경고를 남긴다.",
   "items": {
    "type": "object",
    "required": [
     "net",
     "value"
    ],
    "properties": {
     "net": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "additionalProperties": false
   }
  },
  "ports": {
   "type": "object",
   "description": "입력: input_p+input_n 또는 input. 출력: output_p+output_n 또는 output. AC 전달함수 = 출력(차동이면 p-n) / 입력 AC.",
   "properties": {
    "input_p": {
     "type": "string"
    },
    "input_n": {
     "type": "string"
    },
    "input": {
     "type": "string"
    },
    "output_p": {
     "type": "string"
    },
    "output_n": {
     "type": "string"
    },
    "output": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "predictions": {
   "type": "object",
   "properties": {
    "nodes": {
     "type": "object",
     "additionalProperties": {
      "type": "number"
     },
     "description": "넷 -> 예측 DC 전압. 입력 넷 예측값은 필수(입력 DC), forced 모드는 이 값으로 넷을 고정한다."
    },
    "devices": {
     "type": "object",
     "description": "소자 이름 -> 예측 동작점(크기 규칙). 없는 키는 비교 N/A.",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "ID": {
        "type": "number"
       },
       "VGS": {
        "type": "number"
       },
       "VDS": {
        "type": "number"
       },
       "VSB": {
        "type": "number"
       },
       "gm": {
        "type": "number"
       },
       "gds": {
        "type": "number"
       },
       "gm_id": {
        "type": "number"
       },
       "region": {
        "enum": [
         "sat",
         "triode",
         "off"
        ],
        "description": "엔진이 가정한 영역. judge.sat_margin_V 가 있을 때만 기록 판정. [변경 C23] 'off' = 엔진이 꺼짐으로 예측(전도 확인 대상 아님). 없거나 sat/triode 면 엔진 예측 = 전도."
       },
       "off_current_A": {
        "type": "number",
        "minimum": 0,
        "description": "[신규 C23] 이 소자의 전도 문턱(엔진이 LUT 의 VGS=0 누설 ID 로 이 소자 기하·바이어스에서 계산). 엔진이 전도로 예측한 소자의 SPICE ID(크기 규칙, 부호 포함)가 이 값 이하이면 '꺼짐' -> free verdict FAIL. 없으면 그 소자의 전도 확인은 '판정 안 함'(PASS 불가 -> INCOMPLETE). 오라클은 문턱을 만들지 않는다."
       },
       "tol": {
        "type": "object",
        "description": "[신규] 선택. 소자별 LUT 계산 허용오차(엔진이 그 소자 셀 tol 에서 계산한 값). 한 소자라도 있으면 소자별 모드: ID·gm 기록 판정·forced 경고·iso 판정이 이 값만 쓰고 judge.tolerances 의 ID_rel/gm_rel 스칼라는 쓰지 않는다(없는 소자는 N/A).",
        "properties": {
         "ID_rel": {
          "type": "number",
          "minimum": 0
         },
         "gm_rel": {
          "type": "number",
          "minimum": 0
         },
         "basis": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      },
      "additionalProperties": false
     }
    },
    "metrics": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "measure",
       "value"
      ],
      "properties": {
       "name": {
        "type": "string",
        "description": "엔진 쪽 metric 이름(표시용)"
       },
       "measure": {
        "enum": [
         "dc_gain_db",
         "ugf_hz",
         "pm_deg",
         "cm_pm_deg",
         "f3db_hz",
         "supply_current_A",
         "ratio_db",
         "rout_ohm",
         "noise_th_in_v2hz",
         "noise_fc_in_hz",
         "noise_excess_th",
         "noise_out_int_vrms",
         "offset_in_sigma_mv",
         "swing_out_v",
         "icmr_v",
         "icm_margin_v",
         "slew_rate_v_per_s",
         "settle_s"
        ],
        "description": "[신규] ratio_db = 엔진 ratio_ss_db(CMRR·PSRR 일반형, view 필수, C24). [신규 C26] rout_ohm = 엔진 rout_ss_ohm(출력 포트 뷰, 감지 전용 view 필수). slew_rate_v_per_s·settle_s = 기록 전용(C25: 지금은 SPICE 정의 미정이라 not_measured)."
       },
       "value": {
        "type": "number"
       },
       "rail": {
        "type": "string",
        "description": "supply_current_A 일 때 어느 레일의 공급전류인가"
       },
       "view": {
        "anyOf": [
         {
          "$ref": "#/$defs/ratio_view"
         },
         {
          "$ref": "#/$defs/sense_view"
         }
        ]
       },
       "basis": {
        "type": "string"
       }
      },
      "allOf": [
       {
        "if": {
         "properties": {
          "measure": {
           "const": "ratio_db"
          }
         },
         "required": [
          "measure"
         ]
        },
        "then": {
         "required": [
          "view"
         ],
         "properties": {
          "view": {
           "$ref": "#/$defs/ratio_view"
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "measure": {
           "const": "rout_ohm"
          }
         },
         "required": [
          "measure"
         ]
        },
        "then": {
         "required": [
          "view"
         ],
         "properties": {
          "view": {
           "$ref": "#/$defs/sense_view"
          }
         }
        }
       }
      ],
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
  },
  "acceptance": {
   "type": "object",
   "properties": {
    "constraints": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "measure",
       "op",
       "limit"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "measure": {
        "enum": [
         "dc_gain_db",
         "ugf_hz",
         "pm_deg",
         "cm_pm_deg",
         "f3db_hz",
         "supply_current_A",
         "ratio_db",
         "rout_ohm",
         "noise_th_in_v2hz",
         "noise_fc_in_hz",
         "noise_excess_th",
         "noise_out_int_vrms",
         "offset_in_sigma_mv",
         "swing_out_v",
         "icmr_v",
         "icm_margin_v"
        ],
        "description": "[신규] ratio_db(CMRR·PSRR, view 필수) 는 판정 대상(Q5 (ii), C24). [신규 C26] rout_ohm(출력 저항, 감지 전용 view 필수)도 판정 대상. slew·settling 은 판정 대상이 아니라 여기 없다(C25)."
       },
       "op": {
        "enum": [
         ">=",
         "<="
        ]
       },
       "limit": {
        "type": "number"
       },
       "rail": {
        "type": "string"
       },
       "view": {
        "anyOf": [
         {
          "$ref": "#/$defs/ratio_view"
         },
         {
          "$ref": "#/$defs/sense_view"
         }
        ]
       },
       "basis": {
        "type": "string"
       }
      },
      "allOf": [
       {
        "if": {
         "properties": {
          "measure": {
           "const": "ratio_db"
          }
         },
         "required": [
          "measure"
         ]
        },
        "then": {
         "required": [
          "view"
         ],
         "properties": {
          "view": {
           "$ref": "#/$defs/ratio_view"
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "measure": {
           "const": "rout_ohm"
          }
         },
         "required": [
          "measure"
         ]
        },
        "then": {
         "required": [
          "view"
         ],
         "properties": {
          "view": {
           "$ref": "#/$defs/sense_view"
          }
         }
        }
       }
      ],
      "additionalProperties": false
     }
    },
    "not_measurable": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "SPICE 로 잴 수 없어 뺀 선언 제약(기록용)"
    }
   },
   "additionalProperties": false
  },
  "testbench": {
   "type": "object",
   "required": [
    "dc_choke_H",
    "ac_couple_F",
    "ac"
   ],
   "properties": {
    "dc_choke_H": {
     "type": "number",
