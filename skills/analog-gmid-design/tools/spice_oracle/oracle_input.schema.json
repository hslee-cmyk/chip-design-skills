 "$defs": {
  "transfer_view": {
   "type": "object",
   "additionalProperties": false,
   "description": "[신규 C24] 엔진 spec 전달 뷰와 같은 모양(gmid_engine/authoring/spec_constraints.py TRANSFER_KEYS): ac_excite = {넷: AC 진폭}, sense_p, sense_n(single_ended 면 null), sense_mode.",
   "required": [
    "ac_excite",
    "sense_p",
    "sense_n",
    "sense_mode"
   ],
   "properties": {
    "ac_excite": {
     "type": "object",
     "minProperties": 1,
     "additionalProperties": {
      "type": "number"
     }
    },
    "sense_p": {
     "type": "string",
     "minLength": 1
    },
    "sense_n": {
     "type": [
      "string",
      "null"
     ]
    },
    "sense_mode": {
     "enum": [
      "differential",
      "single_ended"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "sense_mode": {
        "const": "differential"
       }
      }
     },
     "then": {
      "properties": {
       "sense_n": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "else": {
      "properties": {
       "sense_n": {
        "type": "null"
       }
      }
     }
    }
   ]
  },
  "ratio_view": {
   "type": "object",
   "additionalProperties": false,
   "description": "[신규 C24] 엔진 ratio_ss_db 뷰 {num, den}: 각 전달 뷰의 응답비 20*log10(|H_num|/|H_den|).",
   "required": [
    "num",
    "den"
   ],
   "properties": {
    "num": {
     "$ref": "#/$defs/transfer_view"
    },
    "den": {
     "$ref": "#/$defs/transfer_view"
    }
   }
  },
  "sense_view": {
   "type": "object",
   "additionalProperties": false,
   "description": "[신규 C26] 엔진 output_port 뷰(감지 전용, 7a design 3.1): sense_p, sense_n(differential 이면 필수 문자열, single_ended 면 없거나 null), sense_mode. ac_excite 는 둘 수 없다(여기는 정의가 고정: 모든 AC 원 0 + 감지 노드 단위 AC 전류).",
   "required": [
    "sense_p",
    "sense_mode"
   ],
   "properties": {
    "sense_p": {
     "type": "string",
     "minLength": 1
    },
    "sense_n": {
     "type": [
      "string",
      "null"
     ]
    },
    "sense_mode": {
     "enum": [
      "differential",
      "single_ended"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "sense_mode": {
        "const": "differential"
       }
      }
     },
     "then": {
      "required": [
       "sense_n"
      ],
      "properties": {
       "sense_n": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "else": {
      "properties": {
       "sense_n": {
        "type": "null"
       }
      }
     }
    }
   ]
  }
 },
 "additionalProperties": false
}
