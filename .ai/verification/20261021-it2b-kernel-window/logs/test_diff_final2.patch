+def test_it2b_l12b_f_component_port_without_declared_dc_has_undefined_window(tmp_path, r4_access):
+    """oracle 대조: (손) L12 (b) F 성분 입력 DC 미선언 포트 toy. 회로 C 의 in 은 M1 gate, source = gnd(레일) -> 성분이 레일에 닿고 뿌리가 아니다 ->
