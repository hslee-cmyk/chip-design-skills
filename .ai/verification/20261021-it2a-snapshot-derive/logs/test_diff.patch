+def test_it2a_same_theta_ss_reevaluation_from_child_grafts(base):
+    spec, ctx, _, _, res, js = base
+    before = _counts(ctx)
+    ev2 = size_and_seal(ctx, theta(), parent=res.lineage)                   # 같은 θ, parent = ss 가 실린 lineage
