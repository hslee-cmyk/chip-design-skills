+def test_it2a_child_drops_fields_of_writer_outside_kernel(ctx_r4c):
+    """parent 에 커널 밖 writer(ss_dev) 필드를 실은 픽스처 -> child 스냅샷에 그 필드·block_version 없음. 기준 = 같은 θ 의 parent 없는 평가.
